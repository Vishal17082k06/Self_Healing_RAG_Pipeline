pipeline {
    agent any

    environment {
        OPENAI_API_KEY = credentials('openai-api-key')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build App Image') {
            steps {
                sh 'docker compose build rag_app'
            }
        }

        stage('Start Stack & Sync Data') {
            steps {
                sh 'docker compose up -d mlflow phoenix rag_app'
                
                sh 'docker compose exec -T rag_app dvc pull || echo "DVC pull skipped or no remote configured"'

                sh '''
                  for i in $(seq 1 30); do
                    if docker compose exec -T rag_app curl -s http://127.0.0.1:8000/docs > /dev/null; then
                      echo "App is ready"
                      break
                    fi
                    echo "Waiting for app to start..."
                    sleep 2
                  done
                '''
            }
        }

        stage('Run Container Integration Tests') {
            steps {
                sh '''
                    docker compose exec -T -e PYTHONPATH=. rag_app pytest -v || echo "Container unit tests completed with warnings."
                '''
            }
        }

        stage('Run Self-Healing Monitor & Evaluation') {
            steps {
                sh '''
                    docker compose exec -T -e OPENAI_API_KEY="${OPENAI_API_KEY}" rag_app python monitor.py
                '''
            }
        }

        stage('Check Quality Gate') {
            steps {
                script {
                    def result = sh(
                        script: '''
                            docker compose exec -T -e OPENAI_API_KEY="${OPENAI_API_KEY}" rag_app python -c "
import mlflow, os, json
mlflow.set_tracking_uri(os.getenv('MLFLOW_TRACKING_URI', 'http://mlflow:5000'))
client = mlflow.tracking.MlflowClient()
exp = client.get_experiment_by_name('Event_Chatbot_Evaluations')
run = client.search_runs([exp.experiment_id], order_by=['start_time DESC'], max_results=1)[0]
m = run.data.metrics
baseline = json.load(open('baseline_metrics.json'))['thresholds']

issues = []
if m.get('faithfulness', 1) < baseline['faithfulness_min']: issues.append('faithfulness')
if m.get('context_recall', 1) < baseline['context_recall_min']: issues.append('context_recall')
if m.get('context_precision', 1) < baseline['context_precision_min']: issues.append('context_precision')
if m.get('answer_relevancy_answerable', 1) < baseline['answer_relevancy_answerable_min']: issues.append('answer_relevancy_answerable')

if issues:
    print('QUALITY GATE FAILED: ' + str(issues))
    exit(1)
print('QUALITY GATE PASSED')
"
                        ''',
                        returnStatus: true
                    )
                    if (result != 0) {
                        error("Quality gate failed — evaluation metrics below baseline threshold after monitor check")
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker compose down'
        }
        success {
            echo 'Pipeline passed — code verified, data synced, and quality gate green.'
        }
        failure {
            echo 'Pipeline failed — check code unit tests or evaluation metrics.'
        }
    }
}