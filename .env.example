# API Configuration
# Primary: Groq (fast, cost-effective)
GROQ_API_KEY=your_groq_api_key_here

# Fallback: OpenAI (used if Groq fails or is unavailable)
OPENAI_API_KEY=your_openai_api_key_here

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000

# Phoenix Configuration (port 4317 for collecting traces)
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Admin token required to call POST /admin/reload-index (used by monitor.py after self-healing)
ADMIN_TOKEN=change_me_to_a_random_secret

# Base URL monitor.py uses to reach the running app for index hot-swap triggers
RAG_APP_URL=http://127.0.0.1:8000
